{
  "cleanupPeriodDays": 90,
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git grep*)",
      "Bash(git branch*)",
      "Bash(git tag*)",
      "Bash(git stash*)",
      "Bash(git remote*)",
      "Bash(git reflog*)",
      "Bash(git blame*)",
      "Bash(git shortlog*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git ls-tree*)",
      "Bash(git cat-file*)",
      "Bash(git check-ignore*)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(git worktree*)",
      "Bash(git submodule*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(rg *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Read(~/Repos/obsidian-vault/Diary/**)",
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Read(//**/credentials*)",
      "Edit(//**/credentials*)",
      "Read(//**/*.pem)",
      "Edit(//**/*.pem)",
      "Read(//**/.ssh/**)",
      "Edit(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Edit(//**/.aws/**)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh release *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "mcp__*__apply_*",
      "mcp__*__copy_*",
      "mcp__*__create_*",
      "mcp__*__delete_*",
      "mcp__*__label_*",
      "mcp__*__mark_*",
      "mcp__*__respond_*",
      "mcp__*__share_*",
      "mcp__*__trash_*",
      "mcp__*__unlabel_*",
      "mcp__*__unmark_*",
      "mcp__*__untrash_*",
      "mcp__*__update_*",
      "mcp__*__slack_add_*",
      "mcp__*__slack_create_*",
      "mcp__*__slack_schedule_*",
      "mcp__*__slack_send_*",
      "mcp__*__slack_update_*"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git branch -c*)",
      "Bash(git branch -C*)",
      "Bash(git branch -f*)",
      "Bash(git branch -u*)",
      "Bash(git branch --delete*)",
      "Bash(git branch --move*)",
      "Bash(git branch --copy*)",
      "Bash(git branch --force*)",
      "Bash(git branch --set-upstream-to*)",
      "Bash(git branch --unset-upstream*)",
      "Bash(git branch --edit-description*)",
      "Bash(git tag -a*)",
      "Bash(git tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git tag -m*)",
      "Bash(git tag -s*)",
      "Bash(git tag --delete*)",
      "Bash(git tag --force*)",
      "Bash(git stash)",
      "Bash(git stash apply*)",
      "Bash(git stash branch*)",
      "Bash(git stash clear*)",
      "Bash(git stash create*)",
      "Bash(git stash drop*)",
      "Bash(git stash pop*)",
      "Bash(git stash push*)",
      "Bash(git stash save*)",
      "Bash(git stash store*)",
      "Bash(git remote add*)",
      "Bash(git remote prune*)",
      "Bash(git remote remove*)",
      "Bash(git remote rename*)",
      "Bash(git remote rm*)",
      "Bash(git remote set-branches*)",
      "Bash(git remote set-head*)",
      "Bash(git remote set-url*)",
      "Bash(git remote update*)",
      "Bash(git worktree add*)",
      "Bash(git worktree lock*)",
      "Bash(git worktree move*)",
      "Bash(git worktree prune*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree repair*)",
      "Bash(git worktree unlock*)",
      "Bash(git submodule absorbgitdirs*)",
      "Bash(git submodule add*)",
      "Bash(git submodule deinit*)",
      "Bash(git submodule foreach*)",
      "Bash(git submodule init*)",
      "Bash(git submodule set-branch*)",
      "Bash(git submodule set-url*)",
      "Bash(git submodule sync*)",
      "Bash(git submodule update*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/Repos/obsidian-vault"]
  },
  "sandbox": {
    "excludedCommands": [
      "gh api *",
      "gh pr view *",
      "gh pr list *",
      "gh pr diff *",
      "gh issue view *",
      "gh issue list *",
      "gh run view *",
      "gh run list *"
    ]
  },
  "model": "claude-opus-5[1m]",
  "skillOverrides": {
    "claude-api": "off",
    "loop": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true
  },
  "tui": "default",
  "theme": "auto"
}
